# Copy this file to .env (never commit .env) and fill in your own values.

# Polygon Amoy testnet RPC endpoint (public RPC or Alchemy/Infura URL)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a TEST-ONLY wallet funded with Amoy POL from a faucet.
# Never use a wallet that holds real funds.
PRIVATE_KEY=your_test_wallet_private_key_here
