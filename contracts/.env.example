# Copy this file to .env (never commit .env) and fill in your own values.

# Polygon Amoy testnet RPC endpoint (public RPC below, or your own Alchemy/Infura Amoy URL)
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Ethereum Sepolia testnet RPC (fallback network: npm run deploy:sepolia)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a TEST-ONLY wallet funded with Amoy POL or Sepolia ETH from a faucet.
# Never use a wallet that holds real funds.
PRIVATE_KEY=your_test_wallet_private_key_here

# Public wallet ADDRESSES (not keys) of the 3 demo accounts that seed.js registers on Amoy.
# Use 3 MetaMask accounts, e.g. one per teammate. The deployer wallet stays the admin/regulator.
DEMO_MANUFACTURER=0xYourManufacturerWalletAddress
DEMO_DISTRIBUTOR=0xYourDistributorWalletAddress
DEMO_PHARMACY=0xYourPharmacyWalletAddress

# Optional: amount of native token seed.js sends to each demo wallet for gas (e.g. 0.002)
FUND_DEMO_WALLETS=
