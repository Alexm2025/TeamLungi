{
  "name": "medichain-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "MedChain smart contracts: medicine batch custody tracking",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "export-abi": "hardhat compile && node scripts/export-abi.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "seed:amoy": "hardhat run scripts/seed.js --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "seed:sepolia": "hardhat run scripts/seed.js --network sepolia",
    "relay": "node scripts/local-relay.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.29.1"
  }
}
